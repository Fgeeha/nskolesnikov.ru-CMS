# Copy to .env and fill in real values. Never commit .env.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# В development по умолчанию хосты не проверяются, поэтому сайт открывается и
# по IP-адресу машины в локальной сети. Переменную нужно задавать только если
# требуется ограничить список. В production она обязательна.
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_SITE_URL=http://localhost:8000
DJANGO_TIME_ZONE=Europe/Moscow
DJANGO_LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Email ----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.com
# Leave empty to disable contact form notifications.
CONTACT_EMAIL=
CONTACT_RATE_LIMIT_SECONDS=60

# --- Тестовая база --------------------------------------------------------
# Поднимается командой `make test-db-up`. Значения должны совпадать с
# infra/compose/compose.test.yml.
TEST_POSTGRES_DB=portfolio
TEST_POSTGRES_USER=portfolio
TEST_POSTGRES_PASSWORD=portfolio
TEST_POSTGRES_PORT=55432
# Переопределяет строку подключения тестов целиком, если нужна другая база.
# TEST_DATABASE_URL=postgres://portfolio:portfolio@127.0.0.1:55432/portfolio

# --- Production only ------------------------------------------------------
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_MEDIA_ROOT=/app/media
# GUNICORN_WORKERS=3
# NGINX_SERVER_NAME=example.com www.example.com
# HTTP_PORT=80
